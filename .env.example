# ============================================================
# J.A.R.V.I.S. — Variables de entorno
# Arquitectura: Speech-to-Speech (Gemini Live) + Hermes Agent
# ============================================================

# ── API Keys ─────────────────────────────────────────────────
# Obtén tu key en: https://aistudio.google.com/app/apikey

# IALena Voz (Gemini Live - Carril Rápido)
GEMINI_API_KEY=tu_api_key_gemini_aqui  

# Hermes Agent (Carril Lento)
# Puedes usar 1 o múltiples keys. El sistema rotará automáticamente entre ellas 
# para evadir límites de Rate Limit (HTTP 429) cuando Hermes haga tareas intensivas.
HERMES_API_KEY_1=tu_api_key_proyecto_1_aqui
# HERMES_API_KEY_2=tu_api_key_proyecto_2_aqui (opcional, para más RPM)
# HERMES_API_KEY_3=tu_api_key_proyecto_3_aqui (opcional, para más RPM)

# ── Modelos Gemini ────────────────────────────────────────────
MODEL_LIVE=gemini-2.5-flash-native-audio-latest   # Carril Rápido (voz en tiempo real)
MODEL_BRAIN=gemini-2.5-flash                      # Carril Lento (Hermes, tareas complejas)
VOICE_NAME=Aoede                                  # Voz de IALena (Aoede, Puck, Charon, Kore, Fenrir, Leto)

# ── Personalidad ──────────────────────────────────────────────
ASSISTANT_NAME=IALena
USER_NAME=Señor
LANGUAGE=es
