# ====================================================================
#  J A R V I S   C O R E   -   A R C H I V O   D E   E N T O R N O
# ====================================================================

# -- Personalidad y Base ---------------------------------------
ASSISTANT_NAME=JARVIS
USER_NAME=Señor
LANGUAGE=es
LOG_LEVEL=INFO

# -- Claves API (Google Gemini) --------------------------------
# Obtén tus keys en: https://aistudio.google.com/app/apikey

# Carril Rápido: Clave principal para Gemini Live (Voz bidireccional en tiempo real)
GEMINI_API_KEY=tu_api_key_principal_aqui

# Carril Lento: Claves para el cerebro interno (Hermes Agent)
# Puedes colocar 1 o hasta 4 keys. El proxy rotará entre ellas para evadir límites de cuota (HTTP 429).
HERMES_API_KEY_1=tu_api_key_hermes_1_aqui
HERMES_API_KEY_2=tu_api_key_hermes_2_aqui_opcional
HERMES_API_KEY_3=tu_api_key_hermes_3_aqui_opcional
HERMES_API_KEY_4=tu_api_key_hermes_4_aqui_opcional

# Herramientas Hermes para JARVIS Voz (opcional).
# Si HERMES_ENABLED_TOOLSETS esta vacio y defines HERMES_PLATFORM,
# JARVIS usa la configuracion nativa de Hermes en ~/.hermes/config.yaml:
# platform_toolsets.<HERMES_PLATFORM>.
# Ejemplos: web,file,terminal,browser,code_execution,memory,skills,todo,homeassistant,spotify.
HERMES_PLATFORM=
HERMES_ENABLED_TOOLSETS=
HERMES_DISABLED_TOOLSETS=
HERMES_LOAD_SOUL_IDENTITY=1
HERMES_SKIP_CONTEXT_FILES=0
HERMES_SKIP_MEMORY=0
HERMES_PASS_SESSION_ID=1
HERMES_LIVE_IDENTITY_MAX_CHARS=1800
HERMES_LIVE_MEMORY_MAX_CHARS=4000
HERMES_LIVE_AGENT_MEMORY_MAX_CHARS=2200
HERMES_LIVE_SKILLS_MAX=40
HERMES_LIVE_SKILL_DESC_MAX_CHARS=220

# -- Configuración de Modelos ----------------------------------
# Modelo para voz en vivo (debe soportar la API Multimodal Live)
MODEL_LIVE=gemini-3.1-flash-live-preview

# Modelo para razonamiento interno de Hermes (se recomienda Lite para aprovechar 500 RPD de cuota)
MODEL_BRAIN=gemini-3.1-flash-lite

# Voz preferida de Gemini (Ej: Aoede, Puck, Charon, Kore, Fenrir)
VOICE_NAME=Aoede

# -- Presupuestos y Límites (Opcional) -------------------------
DAILY_BUDGET=5.0
MONTHLY_BUDGET=50.0

# -- Funciones Opcionales (Feature Flags) ----------------------
# Desactiva la herramienta directa de YouTube en Live para probar música vía Hermes.
ENABLE_MUSIC_TOOL=1

# Activar gate estricto: Hermes solo se invoca con intención explícita (default: 0).
STRICT_HERMES_INTENT_GATE=0

# -- Ajustes VAD (Voz) ----------------------------------------
# Duración de silencio para cortar (ms). Más alto = espera más antes de responder.
LIVE_VAD_SILENCE_DURATION_MS=1400
# Padding de prefijo antes de inicio de voz (ms).
LIVE_VAD_PREFIX_PADDING_MS=300
# Sensibilidad de inicio de voz: HIGH o LOW.
LIVE_VAD_START_SENSITIVITY=HIGH
# Sensibilidad de fin de voz: HIGH o LOW.
LIVE_VAD_END_SENSITIVITY=LOW
# Límite de caracteres para el contexto de sesión activa inyectado en Live.
LIVE_ACTIVE_SESSION_CONTEXT_MAX_CHARS=1800
