# ====================================================================
#  I A L E N A   C O R E   -   A R C H I V O   D E   E N T O R N O
# ====================================================================

# -- Personalidad y Base ---------------------------------------
ASSISTANT_NAME=IALena
USER_NAME=Señor
LANGUAGE=es
LOG_LEVEL=INFO

# -- Claves API (Google Gemini) --------------------------------
# Obtén tus keys en: https://aistudio.google.com/app/apikey

# Carril Rápido: Clave principal para Gemini Live (Voz bidireccional en tiempo real)
GEMINI_API_KEY=tu_api_key_principal_aqui

# Carril Lento: Claves para el cerebro interno (Hermes Agent)
# Puedes colocar 1 o hasta 4 keys. El proxy rotará entre ellas para evadir límites de cuota (HTTP 429).
HERMES_API_KEY_1=tu_api_key_hermes_1_aqui
HERMES_API_KEY_2=tu_api_key_hermes_2_aqui_opcional
HERMES_API_KEY_3=tu_api_key_hermes_3_aqui_opcional
HERMES_API_KEY_4=tu_api_key_hermes_4_aqui_opcional

# -- Configuración de Modelos ----------------------------------
# Modelo para voz en vivo (debe soportar la API Multimodal Live v1alpha)
MODEL_LIVE=gemini-3.1-flash-live-preview

# Modelo para razonamiento interno de Hermes (se recomienda Lite para aprovechar 500 RPD de cuota)
MODEL_BRAIN=gemini-3.1-flash-lite

# Voz preferida de Gemini (Ej: Aoede, Puck, Charon, Kore, Fenrir)
VOICE_NAME=Aoede

# -- Presupuestos y Límites (Opcional) -------------------------
DAILY_BUDGET=5.0
MONTHLY_BUDGET=50.0
